@app.route('/toggle_group_pause', methods=['POST'])
def toggle_group_pause():
    """ グループの一時停止/再開 """
    try:
        group_id = request.form['group_id']
        group = Group.query.get(group_id)
        if group:
            group.is_paused = not group.is_paused # 状態を反転
            db.session.commit()
            
            status_str = "一時停止" if group.is_paused else "再開"
            flash(f"グループ '{group.name}' を {status_str} しました。", 'success')
        else:
            flash('グループが見つかりません。', 'error')
            
    except Exception as e:
        db.session.rollback()
        flash(f'グループ状態の変更エラー: {e}', 'error')
        
    return redirect(url_for('index'))


# --- 初期化処理 ---
def init_db_and_groups():
    """
    アプリ起動時にデータベースとグループ(1-5)を初期化する
    """
    if not os.path.exists(DATABASE_FILE):
        print(f"データベース {DATABASE_FILE} が見つかりません。新規作成します。")
        db.create_all()
        
        # グループ1～5を自動作成
        for i in range(1, 6):
            if not Group.query.get(i):
                new_group = Group(id=i, name=f'グループ {i}', is_paused=False)
                db.session.add(new_group)
        db.session.commit()
        print("グループ 1～5 を作成しました。")
    else:
        print(f"データベース {DATABASE_FILE} は既に存在します。")
        # 起動時にグループが存在しない場合も作成
        for i in range(1, 6):
            if not Group.query.get(i):
                new_group = Group(id=i, name=f'グループ {i}', is_paused=False)
                db.session.add(new_group)
        db.session.commit()


# --- メイン実行ブロック ---
if __name__ == '__main__':
    # 必要なフォルダがなければ作成
    if not os.path.exists(UPLOAD_FOLDER):
        os.makedirs(UPLOAD_FOLDER)
    if not os.path.exists('templates'):
        os.makedirs('templates')
    
    # GPIOセットアップ
    setup_gpio()
    
    # アプリコンテキスト内でDB初期化
    with app.app_context():
        init_db_and_groups()
    
    # スケジューラ起動
    if not scheduler.running:
        scheduler.start()
        print("スケジューラを起動しました。")
    
    # DBからジョブを読み込みスケジューラに登録
    with app.app_context():
        sync_scheduler_from_db()
        
    # 停止ボタン監視スレッドを開始
    try:
        button_thread = threading.Thread(target=poll_stop_button, daemon=True)
        button_thread.start()
        print(f"GPIO {STOP_BUTTON_PIN} の停止ボタン監視スレッドを開始しました。")
    except Exception as e:
        print(f"ボタン監視スレッドの開始に失敗: {e}")

    # メインの Web サーバー実行
    try:
        print(f"--- 時報チャイムサーバーを起動します (PID: {os.getpid()}) ---")
        print(f"http://[ラズパイのIPアドレス]:5000 でアクセス可能です")
        app.run(debug=False, host='0.0.0.0', port=5000)
    
    except KeyboardInterrupt:
        print("シャットダウン中...")
    
    finally:
        scheduler.shutdown()
        GPIO.cleanup()
        print("サーバーを停止しました。")
